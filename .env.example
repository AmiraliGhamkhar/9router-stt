# 9router-stt: server-side configuration only
NODE_ENV=production
PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/var/lib/9router-stt

# Required for remote gateway clients. Generate a long random value; never use
# a provider key here. Existing active dashboard API keys are also accepted.
STT_GATEWAY_API_KEY=replace-with-a-long-random-gateway-key

# Provider credentials — server-side only. Do not commit real values.
SPEECHMATICS_API_KEY=replace-with-speechmatics-api-key
DEEPGRAM_API_KEY=replace-with-deepgram-api-key

# Upload and realtime safety limits (defaults shown)
STT_MAX_UPLOAD_BYTES=26214400
STT_REALTIME_MAX_CONNECTIONS=100
STT_REALTIME_MAX_FRAME_BYTES=1048576
STT_REALTIME_IDLE_MS=60000

# Optional deterministic routing. Omit to use the documented defaults.
# STT_ROUTING_JSON={"routes":[{"mode":"realtime","language":"fa","profile":"medical","provider":"speechmatics"},{"mode":"batch","language":"fa","profile":"medical","provider":"speechmatics"},{"mode":"realtime","language":"en","profile":"general","provider":"deepgram"},{"mode":"batch","language":"en","profile":"general","provider":"deepgram"},{"mode":"realtime","provider":"deepgram"},{"mode":"batch","provider":"deepgram"}]}
# STT_MODEL_ALIASES_JSON={"medical-fa":"speechmatics/enhanced"}

# Development-only, loopback-only escape hatch. Never set in production.
# STT_ALLOW_INSECURE_LOCAL=true
